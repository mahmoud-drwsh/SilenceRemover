# Media Manager (TypeScript / Bun) - environment variables
# Mirrors the Python remote/.env.example contract.

# Postgres metadata (Supabase pooler URL, including username/password)
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
SUPABASE_DB_SCHEMA=media_manager

# S3-compatible storage (Contabo, MinIO, AWS, ...)
S3_ENDPOINT_URL=https://eu2.contabostorage.com
S3_BUCKET=media-manager
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu2

# Optional - HTTP server port (default 8080)
PORT=8080
