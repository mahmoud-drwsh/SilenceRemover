# Media Manager (TypeScript / Bun) - environment variables

# Postgres metadata
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/media_manager
DB_SCHEMA=media_manager

# 32 random bytes, base64 or hex. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# S3-compatible storage (Contabo, MinIO, AWS, ...)
S3_ENDPOINT_URL=https://eu2.contabostorage.com
S3_BUCKET=media-manager
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu2

# Optional - HTTP server port (default 8080)
PORT=8080

# Required server-side processing worker. Every verified Original is queued.
SOURCE_PROCESSING_WORKER_TOKEN=
OPENROUTER_API_KEY=
SOURCE_PROCESSING_LEASE_SECONDS=1800
SOURCE_PROCESSING_PROFILE=v1
SOURCE_PROCESSING_PROJECT=
SOURCE_PROCESSING_ENCODER=VAAPI
SOURCE_PROCESSING_ENABLE_TITLE_OVERLAY=true
SOURCE_PROCESSING_ENABLE_LOGO_OVERLAY=true
