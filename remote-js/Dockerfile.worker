FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir httpx openrouter pillow arabic-reshaper python-bidi

WORKDIR /workspace
COPY src /workspace/src
COPY packages /workspace/packages
ENV PYTHONPATH=/workspace:/workspace/packages
CMD ["python", "/workspace/packages/sr_source_processing/api.py"]
