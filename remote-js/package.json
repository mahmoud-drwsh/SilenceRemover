{
  "name": "media-manager",
  "version": "1.0.0",
  "description": "Media Manager service for SilenceRemover. HTTP contract over Bun + Hono, talking to Supabase Postgres metadata and S3-compatible object storage.",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "generate-admin-token": "bun run scripts/generate_admin_token.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.1",
    "@hono/zod-validator": "^0.8.0",
    "@smithy/node-http-handler": "4.6.1",
    "file-type": "^22.0.1",
    "hono": "^4.12.18",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.10",
    "typescript": "^5.6.2"
  }
}
